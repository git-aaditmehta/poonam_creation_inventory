{
  "name": "poonam-creation-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute poonam-inventory-db --local --file=migrations/0001_schema.sql",
    "db:migrate:remote": "wrangler d1 execute poonam-inventory-db --remote --file=migrations/0001_schema.sql",
    "db:seed:local": "wrangler d1 execute poonam-inventory-db --local --file=migrations/0002_seed_owner.sql"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  }
}
