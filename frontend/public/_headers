# Cloudflare Pages response headers (replaces vercel.json "headers").
# Every page and file: cross-origin isolation, needed by the on-device database (SQLite/OPFS) and by the
# workers of the scanner and the ID reader (a worker file without these headers is blocked by the browser).
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  X-Content-Type-Options: nosniff

# The offline helper must always be checked for a new version
/sw.js
  Cache-Control: no-cache

# Built files have a content hash in their name: safe to keep for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable
